# Referência das regras já ativas em netlify.toml. Não é necessário copiá-las.
[[redirects]]
  from = "https://lavamed.netlify.app/*"
  to = "https://lavamed.com.br/:splat"
  status = 301
  force = true

[[redirects]]
  from = "https://www.lavamed.com.br/*"
  to = "https://lavamed.com.br/:splat"
  status = 301
  force = true
